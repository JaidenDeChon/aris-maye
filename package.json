        "autoprefixer": "^10.4.20",
        "bits-ui": "1.8.0",
        "clsx": "^2.1.1",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.13.0",
        "formsnap": "^2.0.0",
        "globals": "^16.5.0",
        "lucide-svelte": "^0.474.0",
        "mode-watcher": "^0.5.1",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "sass-embedded": "^1.83.4",
        "svelte": "^5.19.3",
